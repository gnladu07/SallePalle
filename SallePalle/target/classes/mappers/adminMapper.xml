	<select id="getTotalCount" resultType="int">
		select count(*)
	    from member 
	</select>
	
	<select id="getSellerCount" resultType="int">
		select count(*) 
		from member 
		where seller_status = 'W' 
		and deleted_at is null
	</select>
	
	<!-- 전체 회원 수 조회 -->
	<select id="getTotalCountFiltered" resultType="int">
		select count(*)
	    from member
	    where 1=1
	
	    <if test="keyword != null and keyword != ''">
	        <choose>
	            <when test="type == 'userid'">
	                and userid like concat('%', #{keyword}, '%')
	            </when>
	            <when test="type == 'username'">
	                and username like concat('%', #{keyword}, '%')
	            </when>
	            <when test="type == 'nickname'">
	                and nickname like concat('%', #{keyword}, '%')
	            </when>
	        </choose>
	    </if>
	</select>
	
	<!-- 페이징 + 정렬된 회원 목록 조회 -->
	<select id="getMemberListPaged" resultMap="memberMap">
	
	    select 
	        m.*,
	
	        ifnull(pw.balance, 0)  as wallet_balance,
	        ifnull(mw.mileage, 0)  as wallet_mileage
	
	    from member m
	    left join pay_wallet pw
	        on m.member_id = pw.member_id
	    left join mileage_wallet mw
	        on m.member_id = mw.member_id
	
	    where 1=1
	    
	    <!-- 검색 조건 추가 -->
	    <if test="keyword != null and keyword != ''">
	        <choose>
	            <when test="type == 'userid'">
	               and userid like concat('%', #{keyword}, '%')
	            </when>
	            <when test="type == 'username'">
	                and username like concat('%', #{keyword}, '%')
	            </when>
	            <when test="type == 'nickname'">
	                and nickname like concat('%', #{keyword}, '%')
	            </when>
	        </choose>
	    </if>
	
	    <choose>
	        <!-- 가입일 최신순 -->
	        <when test="sort == 'regdate'">
	            order by regdate desc
	        </when>
	
	        <!-- 정지 회원 우선 -->
	        <when test="sort == 'disabled'">
	            order by (enable_flag = '0') desc, regdate desc
	        </when>
	
	        <!-- 탈퇴 회원 우선 -->
	        <when test="sort == 'deleted'">
	            order by (deleted_at is not null) desc, regdate desc
	        </when>
	
	        <!-- 기본값 -->
	        <otherwise>
	            order by regdate desc
	        </otherwise>
	    </choose>
	
	    limit #{amount} offset #{pageStart}
	
	</select>
	
	<select id="getTotalProductCount" resultType="int">
        SELECT COUNT(*) 
        FROM saletrade_board
    </select>  
    
    <select id="getActiveChatRoomCount" resultType="int">
        SELECT COUNT(*) 
        FROM chat_room 
        WHERE admin_closed = 'N'
    </select>
    
	<select id="getAdminGoodsList" resultType="map">
        SELECT 
            s.trade_id, s.regdate, m.userid, m.nickname, m.email AS seller_email,
            s.title, c.item_ctg_name AS category_name, s.status
        FROM saletrade_board s
        JOIN member m ON s.seller_id = m.member_id
        JOIN saletrade_item_category c ON s.item_ctg_id = c.item_ctg_id
        
        <where>
            <if test="keyword != null and keyword != ''">
                <choose>
                    <when test="type == 'userid'"> AND m.userid LIKE CONCAT('%', #{keyword}, '%') </when>
                    <when test="type == 'nickname'"> AND m.nickname LIKE CONCAT('%', #{keyword}, '%') </when>
                    <when test="type == 'title'"> AND s.title LIKE CONCAT('%', #{keyword}, '%') </when>
                    <when test="type == 'status'">
                        <choose>
                            <when test="keyword == '판매중'"> AND s.status IN ('S', 'N') </when>
                            <when test="keyword == '판매중지'"> AND s.status = 'R' </when>
                            <when test="keyword == '삭제'"> AND s.status = 'D' </when>
                            <otherwise> AND s.status = #{keyword} </otherwise>
                        </choose>
                    </when>
                </choose>
            </if>
        </where>
        
        ORDER BY 
        <choose>
            <when test="sort == 'on_sale'"> CASE WHEN s.status IN ('S', 'N') THEN 1 ELSE 2 END, s.regdate DESC </when>
            <when test="sort == 'stopped'"> CASE WHEN s.status = 'R' THEN 1 ELSE 2 END, s.regdate DESC </when>
            <otherwise> s.regdate DESC </otherwise>
        </choose>
        
        LIMIT #{pageStart}, #{amount}
    </select>
    
    <select id="getTotalGoodsCount" resultType="int">
        SELECT COUNT(*)
        FROM saletrade_board s
        JOIN member m ON s.seller_id = m.member_id
        JOIN saletrade_item_category c ON s.item_ctg_id = c.item_ctg_id
        <where>
            <if test="keyword != null and keyword != ''">
                <choose>
                    <when test="type == 'userid'"> AND m.userid LIKE CONCAT('%', #{keyword}, '%') </when>
                    <when test="type == 'nickname'"> AND m.nickname LIKE CONCAT('%', #{keyword}, '%') </when>
                    <when test="type == 'title'"> AND s.title LIKE CONCAT('%', #{keyword}, '%') </when>
                    <when test="type == 'status'">
                        <choose>
                            <when test="keyword == '판매중'"> AND s.status IN ('S', 'N') </when>
                            <when test="keyword == '판매중지'"> AND s.status = 'R' </when>
                            <when test="keyword == '삭제'"> AND s.status = 'D' </when>
                            <otherwise> AND s.status = #{keyword} </otherwise>
                        </choose>
                    </when>
                </choose>
            </if>
        </where>
    </select>

    <update id="adminUpdateGoodsStatus">
        UPDATE saletrade_board
        SET status = #{status}
        WHERE trade_id = #{trade_id}
    </update>
</mapper>