<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.itwillbs.mapper.PayWalletMapper">

    <!-- 보유 포인트 조회 -->
    <select id="getWallet" resultType="PayWalletVO">
        SELECT member_id, balance
        FROM pay_wallet
        WHERE member_id = #{member_id}
    </select>

    <!-- 초기 지갑 생성 -->
    <insert id="createWallet">
        INSERT INTO pay_wallet(member_id, balance)
        VALUES (#{member_id}, 0)
    </insert>

    <!-- 포인트 증감 -->
    <update id="updateBalance">
        UPDATE pay_wallet
        SET balance = #{balance}
        WHERE member_id = #{member_id}
    </update>

</mapper>