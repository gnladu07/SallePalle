	<select id="getTotalCount" resultType="int">
		select count(*)
	    from member 
	</select>
	
	<select id="getSellerCount" resultType="int">
		select count(*) 
		from member 
		where seller_status = 'W' 
		and deleted_at is null
	</select>
	
	<!-- 전체 회원 수 조회 -->
	<select id="getTotalCountFiltered" resultType="int">
		select count(*)
	    from member
	    where 1=1
	
	    <if test="keyword != null and keyword != ''">
	        <choose>
	            <when test="type == 'userid'">
	                and userid like concat('%', #{keyword}, '%')
	            </when>
	            <when test="type == 'username'">
	                and username like concat('%', #{keyword}, '%')
	            </when>
	            <when test="type == 'nickname'">
	                and nickname like concat('%', #{keyword}, '%')
	            </when>
	        </choose>
	    </if>
	</select>
	
	<!-- 페이징 + 정렬된 회원 목록 조회 -->
	<select id="getMemberListPaged" resultMap="memberMap">
	
	    select *
	    from member 
	    where 1=1 
	    
	    <!-- 검색 조건 추가 -->
	    <if test="keyword != null and keyword != ''">
	        <choose>
	            <when test="type == 'userid'">
	               and userid like concat('%', #{keyword}, '%')
	            </when>
	            <when test="type == 'username'">
	                and username like concat('%', #{keyword}, '%')
	            </when>
	            <when test="type == 'nickname'">
	                and nickname like concat('%', #{keyword}, '%')
	            </when>
	        </choose>
	    </if>
	
	    <choose>
	        <!-- 가입일 최신순 -->
	        <when test="sort == 'regdate'">
	            order by regdate desc
	        </when>
	
	        <!-- 정지 회원 우선 -->
	        <when test="sort == 'disabled'">
	            order by (enable_flag = '0') desc, regdate desc
	        </when>
	
	        <!-- 탈퇴 회원 우선 -->
	        <when test="sort == 'deleted'">
	            order by (deleted_at is not null) desc, regdate desc
	        </when>
	
	        <!-- 기본값 -->
	        <otherwise>
	            order by regdate desc
	        </otherwise>
	    </choose>
	
	    limit #{amount} offset #{pageStart}
	
	</select>  
</mapper>