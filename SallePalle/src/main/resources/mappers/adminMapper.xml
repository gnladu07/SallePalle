	<!-- resultMap 설정 -->
	<resultMap id="memberMap" type="MemberVO" >
		<id property="member_id" column="member_id"/>
    	<result property="userid" column="userid"/>
		<result property="userpw" column="userpw" />
	    <result property="username" column="username" />
	    <result property="nickname" column="nickname" />
	    <result property="email" column="email" />
	    <result property="gender" column="gender" />
	    <result property="toplct_id" column="toplct_id" />
	    <result property="detail_address" column="detail_address" />
	    <result property="profile_img" column="profile_img" />
	    <result property="seller_status" column="seller_status" />
	    <result property="provider" column="provider" />
	    
	    <result property="provider_id" column="provider_id"/>
	    <result property="mobile" column="mobile"/>
	    <result property="birth6" column="birth6"/>
	    	    
	    <result property="enable_flag" column="enable_flag" />
	    <result property="regdate" column="regdate" />
	    <result property="updatedate" column="updatedate" />
	    <result property="deleted_at" column="deleted_at" />
	
	    <result property="agree_terms_required" column="agree_terms_required" />
	    <result property="agree_privacy_required" column="agree_privacy_required" />
	    <result property="agree_location_optional" column="agree_location_optional" />
	    <result property="agree_marketing_email" column="agree_marketing_email" />
	    <result property="agree_marketing_sms" column="agree_marketing_sms" />
	    
	    <collection property="authList" ofType="MemberAuthVO">
	    	<result property="userid" column="userid" />
	    	<result property="auth" column="auth" />
	    </collection>
	</resultMap>

