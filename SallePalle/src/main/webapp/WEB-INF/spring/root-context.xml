	<!-- mailSender -->     
	                 
	<!-- 객체를 찾기(외부에서 선언된 @Repository, @service 이 붙어있는 객체) -->
	<context:component-scan base-package="com.itwillbs.persistence" />
	<context:component-scan base-package="com.itwillbs.service" />
	<context:component-scan base-package="com.itwillbs.config" />
	<context:component-scan base-package="com.itwillbs.component" />
</beans>
